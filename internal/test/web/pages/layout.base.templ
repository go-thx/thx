package pages

templ baseLayout(content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>THX</title>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@v2.0.8/dist/htmx.min.js" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/htmx-ext-sse@2.2.4/dist/sse.min.js" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/htmx-ext-ws@2.0.4/dist/ws.min.js" crossorigin="anonymous"></script>
		</head>
		<body hx-ext="preload">
			@content
		</body>
	</html>
}
