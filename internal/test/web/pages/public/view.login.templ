package public

import (
	"thx.test/gen/routes"
	"thx.test/web/mw"
)

templ loginView(props loginProps) {
	<div>PUBLIC</div>

	<form hx-post={ routes.Public().PostLogin().Path() }>
		<input type="hidden" name={ mw.CSRFFieldName() } value={ mw.GetCSRFToken(ctx) }/>
		<input type="hidden" name="path" value={ props.form.Path }/>
		<button type="submit">Login</button>
	</form>
}
